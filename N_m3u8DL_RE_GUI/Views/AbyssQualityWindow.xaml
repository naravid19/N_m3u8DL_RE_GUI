<Window x:Class="N_m3u8DL_RE_GUI.Views.AbyssQualityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_AbyssQualityTitle}"
        Height="300" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1C1C22">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/N_m3u8DL_RE_GUI;component/Resources/PickerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Str_AbyssQualityPrompt}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <ListBox Grid.Row="1"
                 x:Name="List_Qualities"
                 AutomationProperties.Name="{DynamicResource Str_AbyssQualityList}"
                 MouseDoubleClick="List_Qualities_MouseDoubleClick"
                 Background="#141418"
                 BorderBrush="{StaticResource BorderBrushCustom}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Description}" Margin="4"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="Button_Cancel" Content="{DynamicResource Str_AbyssQualityCancel}" IsCancel="True"
                    AutomationProperties.Name="{DynamicResource Str_AbyssQualityCancel}"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="90"/>
            <Button x:Name="Button_Use" Content="{DynamicResource Str_AbyssQualityUse}" IsDefault="True"
                    AutomationProperties.Name="{DynamicResource Str_AbyssQualityUse}"
                    Click="Button_Use_Click"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
