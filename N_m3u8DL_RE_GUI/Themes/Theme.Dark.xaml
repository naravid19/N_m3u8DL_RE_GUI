<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Ratios in comments are WCAG 2.1, verified by XamlContrastTests. -->
    <SolidColorBrush x:Key="BgBrush" Color="#0D0D0F"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141418"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1C1C22"/>
    <!-- #2A2A38 measured 1.20:1 on Card — a border nobody could see. -->
    <SolidColorBrush x:Key="BorderBrushCustom" Color="#66667C"/>
    <!-- Accent as a SURFACE (button fill, tab indicator). White on it is 4.61:1. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5865F2"/>
    <!-- Accent as TEXT. #5865F2 was 3.68:1 on Card; this is 5.44:1. -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7A87FF"/>
    <!-- Hover/pressed darken so contrast rises on interaction, never falls. -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4350D8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3E4ACB"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F8"/>
    <!-- #8888A8 measured 4.07:1 on RaisedSurface, 4.18:1 on FillTertiary, 3.99:1 on
         NavSelected — under AA on every filled surface. This clears 4.5:1 on all of
         them (worst 5.23:1 on NavSelected) and still sits well under TextPrimary. -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9EB8"/>
    <SolidColorBrush x:Key="CfAmberBrush" Color="#F39C12"/>
    <SolidColorBrush x:Key="CommandBarBrush" Color="#0A0A0D"/>
    <SolidColorBrush x:Key="CommandTextBrush" Color="#A8C0FF"/>
    <SolidColorBrush x:Key="DropLabelBrush" Color="#EC7063"/>
    <!-- Semantic tokens shared by both themes' structure, themed per palette. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#2ECC71"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E74C3C"/>
    <SolidColorBrush x:Key="CfWarningBgBrush" Color="#2A2113"/>
    <SolidColorBrush x:Key="DimBrush" Color="#78789A"/>
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#141418"/>

    <!-- iOS-like component tokens. Append-only: the keys above are frozen because
         XamlContrastTests asserts each of their values individually. -->
    <!-- Accent as a FILL (primary button, switch, pill). White on it is 4.70:1. -->
    <SolidColorBrush x:Key="AccentFillBrush" Color="#0071E3"/>
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#0066CC"/>
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#0056AC"/>
    <!-- Accent as text/icon/focus ring. -->
    <SolidColorBrush x:Key="TintBrush" Color="#0A84FF"/>
    <!-- Hairline between rows inside a group. -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#33333A"/>
    <!-- Switch track while on. -->
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#30D158"/>
    <!-- Switch track while off, secondary button fill, progress groove. -->
    <SolidColorBrush x:Key="FillTertiaryBrush" Color="#2A2A2E"/>
    <!-- Selected sidebar row. -->
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#192F46"/>
    <!-- Scrollbar thumb. -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4A50"/>
    <!-- Drop-down popup surface, one step above Card. -->
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#2C2C2E"/>
    <!-- Placeholder / disabled text. Disabled-only, so it answers to the 3:1 floor the
         WCAG exemption sets rather than the 4.5:1 body-text line; #5A5A5E was 2.47:1
         on Card (unreadable even for a disabled state), this is 4.95:1. -->
    <SolidColorBrush x:Key="TertiaryLabelBrush" Color="#8A8A92"/>
    <!-- Destructive fill (stop button). White on it is 5.44:1. -->
    <SolidColorBrush x:Key="DangerFillBrush" Color="#C0392B"/>

    <!-- Input fields. CardBrush (#1C1C22) is the group card itself, so a field filled
         with it would have no visible edge inside the card; this sits one step above it
         and replaces the resting outline entirely. -->
    <SolidColorBrush x:Key="InputFillBrush" Color="#26262B"/>
    <!-- Hover / focused fill: one more step up, still below BorderBrushCustom. -->
    <SolidColorBrush x:Key="InputFillHoverBrush" Color="#2E2E34"/>
    <!-- Focus ring. TintBrush pre-mixed at ~18% over the card: the ring is painted as an
         opaque stroke, and the 6-digit token format carries no alpha. -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#1B3355"/>

    <!-- Contrast pass. These two exist because the tokens above could not be paired for
         a filled row or a hover state that both cleared AA: the accent-on-NavSelected
         pair was 3.75:1, and the only "deeper than FillTertiary" step in the ramp was
         BorderBrushCustom, a #66667C jump that dropped label contrast 2.5x on hover. -->
    <!-- Tint as TEXT (and as the icon stroke that follows it) over a filled row: the
         selected sidebar item and the checked log pill. #0A84FF is 3.75:1 on
         NavSelected; this is 6.10:1. TintBrush itself is untouched — it stays the
         focus-ring / selection / outline colour, where it is a UI boundary, not text. -->
    <SolidColorBrush x:Key="TintOnFillBrush" Color="#66B2FF"/>
    <!-- Hover step for a FillTertiary fill: one step deeper instead of the BorderBrushCustom
         jump. TextPrimary on it is 11.06:1, and the fill itself still moves enough to
         read as pressed (1.16:1 against FillTertiary). -->
    <SolidColorBrush x:Key="FillTertiaryHoverBrush" Color="#34343C"/>
</ResourceDictionary>
