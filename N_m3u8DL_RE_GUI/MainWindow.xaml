                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TextBox_DropSubtitle" AutomationProperties.Name="Drop Subtitle Regex" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged" Margin="0,6,0,0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource Str_GroupTimeRangeMux}" Style="{StaticResource GroupBoxStyle}">
