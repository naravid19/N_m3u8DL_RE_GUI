                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    
                                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CheckBox_ParserOnly" AutomationProperties.Name="Parse Only, Skip Download" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_ParserOnly}" ToolTip="{DynamicResource Str_ParserOnlyTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="CheckBox_Concurrent" AutomationProperties.Name="Concurrent Download" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_Concurrent}" ToolTip="{DynamicResource Str_ConcurrentTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="2" x:Name="CheckBox_DisableMerge" AutomationProperties.Name="Skip Merge" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_DisableMerge}" ToolTip="{DynamicResource Str_DisableMergeTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    
                                    <CheckBox Grid.Row="2" Grid.Column="0" x:Name="CheckBox_BinaryMerge" AutomationProperties.Name="Binary Merge" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_BinaryMerge}" ToolTip="{DynamicResource Str_BinaryMergeTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CheckBox_AudioOnly" AutomationProperties.Name="Audio Only" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_AudioOnly}" ToolTip="{DynamicResource Str_AudioOnlyTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="2" x:Name="CheckBox_DisableCheck" AutomationProperties.Name="Skip Segment Count Check" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_DisableCheck}" ToolTip="{DynamicResource Str_DisableCheckTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    
                                    <CheckBox Grid.Row="3" Grid.Column="0" x:Name="CheckBox_SubOnly" AutomationProperties.Name="Subtitle Only" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_SubOnly}" ToolTip="{DynamicResource Str_SubOnlyTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="CheckBox_AutoSubFix" AutomationProperties.Name="Auto Fix Subtitles" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_AutoSubFix}" ToolTip="{DynamicResource Str_AutoSubFixTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="3" Grid.Column="2" x:Name="CheckBox_AutoSelect" AutomationProperties.Name="Auto Select Best Quality" Style="{StaticResource CheckBoxStyle}"
                                              Content="{DynamicResource Str_AutoSelect}" ToolTip="{DynamicResource Str_AutoSelectTooltip}"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{DynamicResource Str_SubFormat}" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="Combo_SubFormat" AutomationProperties.Name="Subtitle Format" SelectedIndex="0" Width="100"
                                              SelectionChanged="Combo_SubFormat_SelectionChanged">
                                        <ComboBoxItem Content="SRT"/>
                                        <ComboBoxItem Content="VTT"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: NETWORK & SPEED -->
            <TabItem Header="{DynamicResource Str_TabNetwork}" AutomationProperties.Name="Network">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="{DynamicResource Str_GroupRequestProxy}" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Headers}" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBox_Headers" Style="{StaticResource TextBoxStyle}" 
                                         TextChanged="TextChanged"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="72"
                                         AutomationProperties.Name="HTTP Headers"
                                         ToolTip="{DynamicResource Str_HeadersTooltip}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_BaseUrl}" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBox_Baseurl" Style="{StaticResource TextBoxStyle}" 
                                         TextChanged="TextChanged" Margin="0,8,0,0"
                                         AutomationProperties.Name="Base URL"
                                         ToolTip="{DynamicResource Str_BaseUrlTooltip}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_Proxy}" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TextBox_Proxy" Style="{StaticResource TextBoxStyle}" 
                                         TextChanged="TextChanged" Margin="0,8,0,0"
                                         AutomationProperties.Name="Proxy Address"
                                         ToolTip="{DynamicResource Str_ProxyTooltip}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource Str_GroupPerformance}" Style="{StaticResource GroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="{DynamicResource Str_MaxThreads}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TextBox_Max" AutomationProperties.Name="Maximum Download Threads" Text="12" Width="45" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged" HorizontalContentAlignment="Center" ToolTip="{DynamicResource Str_MaxThreadsTooltip}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="{DynamicResource Str_RetryCount}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TextBox_Retry" AutomationProperties.Name="Download Retry Count" Text="3" Width="45" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged" HorizontalContentAlignment="Center" ToolTip="{DynamicResource Str_RetryCountTooltip}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="{DynamicResource Str_Timeout}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TextBox_Timeout" AutomationProperties.Name="HTTP Request Timeout In Seconds" Text="100" Width="45" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged" HorizontalContentAlignment="Center" ToolTip="{DynamicResource Str_TimeoutTooltip}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="{DynamicResource Str_MaxSpeed}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TextBox_MaxSpeed" AutomationProperties.Name="Download Speed Limit" Text="" Width="60" Style="{StaticResource TextBoxStyle}"
                                             TextChanged="TextChanged" HorizontalContentAlignment="Center" ToolTip="{DynamicResource Str_MaxSpeedTooltip}"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Cloudflare Bypass Section -->
                        <!-- "curl__cffi": the header ContentPresenter sets RecognizesAccessKey="True",
                             so WPF's AccessText eats a single underscore. Doubling it renders one. -->
                        <GroupBox Header="{DynamicResource Str_GroupCloudflareBypass}" Style="{StaticResource GroupBoxStyle}" Foreground="{StaticResource CfAmberBrush}">
                            <StackPanel>
                                <CheckBox x:Name="CheckBox_BypassCF" AutomationProperties.Name="Enable Cloudflare Bypass" Content="{DynamicResource Str_BypassCloudflare}"
                                          Foreground="{StaticResource CfAmberBrush}" FontWeight="SemiBold" Margin="0,0,0,6"
                                          Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                
                                <Border x:Name="Border_CfScopeWarning" Visibility="Collapsed"
                                        Background="#2A2113" BorderBrush="{StaticResource CfAmberBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource CfAmberBrush}"
                                               AutomationProperties.Name="Cloudflare Mode Scope Warning"
                                               Text="{DynamicResource Str_CfScopeWarning}"/>
                                </Border>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_CfEngine}" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="1" x:Name="Combo_CFEngine" AutomationProperties.Name="Cloudflare Bypass Engine" SelectedIndex="0"
                                              SelectionChanged="Combo_CFEngine_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource Str_CfEngineAuto}" Tag="auto"/>
                                        <ComboBoxItem Content="{DynamicResource Str_CfEngineDirect}" Tag="direct"/>
                                        <ComboBoxItem Content="{DynamicResource Str_CfEngineProxy}" Tag="proxy"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_CfFingerprint}" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="1" x:Name="Combo_CFImpersonate" AutomationProperties.Name="Cloudflare TLS Fingerprint" SelectedIndex="0"
                                              SelectionChanged="Combo_CFImpersonate_SelectionChanged">
                                        <ComboBoxItem Content="chrome" Tag="chrome"/>
                                        <ComboBoxItem Content="chrome120" Tag="chrome120"/>
                                        <ComboBoxItem Content="chrome131" Tag="chrome131"/>
                                        <ComboBoxItem Content="edge101" Tag="edge101"/>
                                        <ComboBoxItem Content="safari17_0" Tag="safari17_0"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_CfReferer}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_CFReferer" AutomationProperties.Name="Cloudflare Referer Header" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_CfCookie}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_CFCookie" AutomationProperties.Name="Cloudflare Cookie" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                </Grid>

                                <CheckBox x:Name="CheckBox_CFKeepSegs" AutomationProperties.Name="Keep Segment Files After Merge" Content="{DynamicResource Str_CfKeepSegs}"
                                          Style="{StaticResource CheckBoxStyle}" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: SECURITY & ENCRYPTION -->
            <TabItem Header="{DynamicResource Str_TabDecryption}" AutomationProperties.Name="Security">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="{DynamicResource Str_GroupKeysVectors}" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Key}" Style="{StaticResource LabelStyle}"/>
