                                              SelectionChanged="Combo_CFImpersonate_SelectionChanged">
                                        <ComboBoxItem Content="chrome" Tag="chrome"/>
                                        <ComboBoxItem Content="chrome120" Tag="chrome120"/>
                                        <ComboBoxItem Content="chrome131" Tag="chrome131"/>
                                        <ComboBoxItem Content="edge101" Tag="edge101"/>
                                        <ComboBoxItem Content="safari17_0" Tag="safari17_0"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Referer" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_CFReferer" AutomationProperties.Name="Cloudflare Referer Header" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CF Cookie" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1" x:Name="TextBox_CFCookie" AutomationProperties.Name="Cloudflare Cookie" Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"/>
                                </Grid>

                                <CheckBox x:Name="CheckBox_CFKeepSegs" AutomationProperties.Name="Keep Segment Files After Merge" Content="Keep segment files after merge"
                                          Style="{StaticResource CheckBoxStyle}" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: SECURITY & ENCRYPTION -->
            <TabItem Header="🔒 Security" AutomationProperties.Name="Security">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="Keys &amp; Vectors" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
