<Window x:Class="N_m3u8DL_RE_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N_m3u8DL_RE_GUI"
        mc:Ignorable="d"
        Title="N_m3u8DL-RE GUI v2.1.5" 
        Height="660" Width="920"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Closing="Window_Closing" 
        Loaded="Window_Loaded"
        Background="#0D0D0F"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        DataContext="{Binding Source={StaticResource Locator}, Path=MainViewModel}">
    
    <!-- These route to the window's own handlers via CommandBindings, NOT to MainViewModel.
         No control in this window binds to the ViewModel, so its DownloadOptions is always
         empty; commands aimed there reported "no URL" no matter what the user had typed.
         Alt+G is already supplied by the "_GO" access key, so it is not repeated here. -->
    <Window.InputBindings>
        <KeyBinding Gesture="Alt+S" Command="{x:Static local:MainWindow.StartDownloadRoutedCommand}"/>
        <KeyBinding Gesture="Escape" Command="{x:Static local:MainWindow.StopDownloadRoutedCommand}"/>
    </Window.InputBindings>
    
    <Window.Resources>
        <!-- Color Brushes. Ratios in comments are WCAG 2.1, verified by XamlContrastTests. -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0D0D0F"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#141418"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1C1C22"/>
        <!-- #2A2A38 measured 1.20:1 on Card — a border nobody could see. -->
        <SolidColorBrush x:Key="BorderBrushCustom" Color="#66667C"/>
        <!-- Accent as a SURFACE (button fill, tab indicator). White on it is 4.61:1. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5865F2"/>
        <!-- Accent as TEXT. #5865F2 was 3.68:1 on Card; this is 5.44:1. -->
        <SolidColorBrush x:Key="AccentTextBrush" Color="#7A87FF"/>
        <!-- Hover/pressed darken so contrast rises on interaction, never falls. -->
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4350D8"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3E4ACB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F8"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8888A8"/>
        <SolidColorBrush x:Key="CfAmberBrush" Color="#F39C12"/>
        <SolidColorBrush x:Key="CommandBarBrush" Color="#0A0A0D"/>
        <SolidColorBrush x:Key="CommandTextBrush" Color="#A8C0FF"/>
        <SolidColorBrush x:Key="DropLabelBrush" Color="#EC7063"/>

        <!-- Accessible Focus Visual Style for high visibility keyboard navigation -->
        <Style x:Key="AccessibleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="{StaticResource AccentBrush}"
                                   StrokeThickness="2" StrokeDashArray="1 1"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        
        <!-- TextBox Style -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <!-- Validation state arrives as a Tag, not as a local BorderBrush value.
                     A local value outranks style triggers in WPF property precedence, so
                     writing BorderBrush directly permanently removed the focus indicator
                     from TextBox_URL, TextBox_Proxy and TextBox_EXE. Declared first so the
                     focus and hover triggers below still win while the field is active. -->
                <Trigger Property="Tag" Value="invalid">
                    <Setter Property="BorderBrush" Value="{StaticResource DropLabelBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- CheckBox Style -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#2ECC71"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Primary Action Button Style -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrushCustom}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Update Pill Button Style -->
        <Style x:Key="UpdatePillButtonStyle" TargetType="Button">
            <!-- #1E8449 rather than #2ECC71: white on #2ECC71 measures 2.10:1, the worst
                 contrast in the window. #1E8449 gives 4.72:1 and clears WCAG AA. -->
            <Setter Property="Background" Value="#1E8449"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Style.Triggers>
                <!-- Ramp goes darker on interaction so contrast never drops below the
                     resting 4.72:1. The old ramp got lighter and fell to 2.87:1 on hover. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#196F3D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#145A32"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- GroupBox Style with full dark-theme template -->
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header pill -->
                            <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    Padding="10,5" CornerRadius="3,3,0,0">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                                  TextBlock.FontSize="11"/>
                            </Border>
                            <!-- Content area -->
                            <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,0,1,1"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="0,0,3,3">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ContextMenu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <!-- Dark ScrollBar / ScrollViewer -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2">
                <Grid x:Name="hasGroup">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource TextSecondaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="arrow" Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Dark Theme Styling (Fixes White Dropdown & Light Box Bug) -->
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrushCustom}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid">
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"/>

                            <ContentPresenter x:Name="contentTemplate"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="1"
                                   PopupAnimation="Slide"
                                   Placement="Bottom">
                                <Border x:Name="dropDownBorder"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrushCustom}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=mainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter TargetName="toggleButton" Property="Background" Value="#141418"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical TabControl Navigation Style -->
        <Style x:Key="LeftTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C1C22"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C1C22"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- ZONE A: Top Dock -->
            <RowDefinition Height="*"/>    <!-- ZONE B & C: Sidebar + Content -->
            <RowDefinition Height="Auto"/> <!-- ZONE D: Bottom Command Bar -->
        </Grid.RowDefinitions>

        <!-- ================== ZONE A: TOP DOCK ================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrushCustom}" BorderThickness="1"
                Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <!-- Title Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="N_m3u8DL-RE GUI" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}"/>
                        <TextBlock Text="v2.1.5" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                        <Button x:Name="Button_UpdateBadge" AutomationProperties.Name="New Version Available" Visibility="Collapsed"
                                Style="{StaticResource UpdatePillButtonStyle}"
                                Margin="10,0,0,0"
                                Click="Button_UpdateBadge_Click"
                                ToolTip="Click to view and download latest release on GitHub"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="CheckBox_TopMost" AutomationProperties.Name="Always on Top" Style="{StaticResource CheckBoxStyle}"
                              Content="Always on Top" ToolTip="Keep window on top"
                              Checked="SetTopMost" Unchecked="SetTopMost"/>
                </Grid>

                <!-- URL Hero Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Input URL" Style="{StaticResource LabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox Grid.Column="1" x:Name="TextBox_URL" Style="{StaticResource TextBoxStyle}" 
                             FontSize="13" TextChanged="TextChanged" AllowDrop="True"
                             PreviewKeyDown="TextBox_URL_PreviewKeyDown"
                             MouseDoubleClick="TextBox_URL_MouseDoubleClick"
                             PreviewDragOver="TextBox_URL_PreviewDragOver"
                             PreviewDrop="TextBox_URL_PreviewDrop"
                             PreviewDragEnter="TextBox_URL_PreviewDragEnter"
                             AutomationProperties.Name="Input URL or File Path"
                             AutomationProperties.HelpText="M3U8/MPD URL or local file path"
                             ToolTip="M3U8/MPD/ISM URL or local file path. Double-click to paste from clipboard"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="Button_GO" Content="▶ _GO" 
                                Style="{StaticResource ButtonStyle}"
                                Click="Button_GO_Click"
                                AutomationProperties.Name="Start Download"
                                AutomationProperties.HelpText="Start downloading current stream"
                                ToolTip="Start download (Alt+G, Alt+S, Enter)"/>
                        <Button x:Name="Button_Stop" Content="⏹ S_top"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Background="#C0392B" Foreground="#FFFFFF" BorderThickness="0"
                                Click="Button_Stop_Click" Margin="6,0,0,0" Padding="12,6"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Stop Download"
                                AutomationProperties.HelpText="Cancel active download process"
                                ToolTip="Cancel current download (Alt+T, Escape)"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Path Sub-row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Save Dir" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="1" x:Name="TextBox_WorkDir" Style="{StaticResource TextBoxStyle}" 
                             TextChanged="TextChanged"
                             AutomationProperties.Name="Save Directory Path"
                             ToolTip="Output directory for downloads"/>
                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}"
                            Click="Button_SelectDir_Click" Margin="6,0,0,0"
                            AutomationProperties.Name="Browse Save Directory"/>

                    <TextBlock Grid.Column="4" Text="Save Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="5" x:Name="TextBox_Title" Style="{StaticResource TextBoxStyle}" 
                             TextChanged="TextChanged"
                             PreviewKeyDown="TextBox_Title_PreviewKeyDown"
                             MouseDoubleClick="TextBox_Title_MouseDoubleClick"
                             AutomationProperties.Name="Save Filename"
                             ToolTip="Output filename. Double-click to auto-detect from URL"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================== ZONE B & C: LEFT NAV SIDEBAR + MAIN CONTENT ================== -->
        <TabControl Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushCustom}" BorderThickness="1" TabStripPlacement="Left" MinWidth="160">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource LeftTabItemStyle}"/>
            </TabControl.Resources>

            <!-- TAB 1: DOWNLOAD & BASIC -->
            <TabItem Header="📦 Download" AutomationProperties.Name="Download">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="Basic Paths" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Executable" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBox_EXE" Text="N_m3u8DL-RE.exe" 
                                         Style="{StaticResource TextBoxStyle}" TextChanged="TextChanged"
                                         AutomationProperties.Name="N_m3u8DL-RE Executable Path"
                                         ToolTip="Path to N_m3u8DL-RE executable">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Cut" Command="Cut"/>
                                            <MenuItem Header="Copy" Command="Copy"/>
                                            <MenuItem Header="Paste" Command="Paste"/>
                                            <Separator/>
                                            <MenuItem Header="Get Downloader" Click="Menu_GetDownloader"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Temp Dir" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBox_TmpDir" Style="{StaticResource TextBoxStyle}"
                                         TextChanged="TextChanged" Margin="0,8,0,0"
                                         AutomationProperties.Name="Temporary Directory Path"
                                         ToolTip="Temporary directory for segment files"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Download Flags" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="CheckBox_Del" AutomationProperties.Name="Delete Temporary Files After Done" Style="{StaticResource CheckBoxStyle}"
                                              Content="Delete After Done" ToolTip="Delete temporary files after merge"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="CheckBox_DisableDate" AutomationProperties.Name="Do Not Write Date Info" Style="{StaticResource CheckBoxStyle}"
                                              Content="No Date Info" ToolTip="Don't write date info during muxing"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="2" x:Name="CheckBox_DisableProxy" AutomationProperties.Name="Disable System Proxy" Style="{StaticResource CheckBoxStyle}"
                                              Content="No System Proxy" ToolTip="Disable system proxy"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    
                                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CheckBox_ParserOnly" AutomationProperties.Name="Parse Only, Skip Download" Style="{StaticResource CheckBoxStyle}"
                                              Content="Skip Download" ToolTip="Parse only, don't download"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="CheckBox_Concurrent" AutomationProperties.Name="Concurrent Download" Style="{StaticResource CheckBoxStyle}"
                                              Content="Concurrent DL" ToolTip="Download audio/video/subtitle concurrently"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="2" x:Name="CheckBox_DisableMerge" AutomationProperties.Name="Skip Merge" Style="{StaticResource CheckBoxStyle}"
                                              Content="Skip Merge" ToolTip="Don't merge segments after download"
                                              Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
                                    
