            <!-- TAB 2: NETWORK & SPEED -->
            <TabItem Header="🌐 Network" AutomationProperties.Name="Network">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="Request &amp; Proxy" Style="{StaticResource GroupBoxStyle}">
