<Application x:Class="N_m3u8DL_RE_GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:N_m3u8DL_RE_GUI"
             xmlns:viewmodels="clr-namespace:N_m3u8DL_RE_GUI.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Theme dictionaries provide the app-wide palette; ThemeManager swaps
                 this merged entry at runtime for Dark/Light switching. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Dark.xaml"/>
                <!-- Icon geometries + the IconPath contract. Merged after the palette
                     and never swapped, so ThemeManager's "Themes/Theme." sweep only
                     replaces the palette entry. -->
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- ViewModel Locator -->
            <viewmodels:ViewModelLocator x:Key="Locator" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
